# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────
# Local MongoDB:   mongodb://127.0.0.1:27017/saaspulse
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/saaspulse
# Leave empty in development to use a throwaway in-memory MongoDB (data resets on restart).
MONGODB_URI=

# Seed demo data automatically when the database is empty
AUTO_SEED=true

# Time zone used to bucket revenue into months
REPORTING_TZ=Asia/Kolkata
